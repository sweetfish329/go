# Stage 0: WASM Builder (Go Vision & Engine)
FROM golang:1.27-alpine AS wasm-builder
WORKDIR /app
COPY wasm-kifu/ ./wasm-kifu/
WORKDIR /app/wasm-kifu
RUN cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" web/wasm/wasm_exec.js && \
    GOOS=js GOARCH=wasm go build -ldflags="-w -s" -o web/wasm/kifu.wasm ./cmd/wasm

# Stage 1: Frontend Builder
FROM oven/bun:alpine AS frontend-builder
WORKDIR /app/kifu/frontend
COPY kifu/frontend/package.json kifu/frontend/bun.lock ./
RUN bun install
COPY kifu/frontend/ ./
COPY wasm-kifu/ /app/wasm-kifu/
# wasm-builder でビルドした最新バイナリ・ランタイムを上書き配置
COPY --from=wasm-builder /app/wasm-kifu/web/wasm/kifu.wasm /app/wasm-kifu/web/wasm/kifu.wasm
COPY --from=wasm-builder /app/wasm-kifu/web/wasm/wasm_exec.js /app/wasm-kifu/web/wasm/wasm_exec.js
COPY --from=wasm-builder /app/wasm-kifu/web/wasm/wasm_exec.js ./public/wasm/wasm_exec.js
RUN bun run build

# Stage 2: Go Backend Builder
FROM golang:1.27-alpine AS backend-builder
WORKDIR /app
RUN apk add --no-cache git
# Copy Go source code
COPY kifu/backend/ ./
RUN go mod tidy && go mod download
# Build Go server
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o server ./cmd/server

# Stage 3: Runner
FROM alpine:latest
RUN apk --no-cache add ca-certificates && \
    mkdir -p /data
WORKDIR /app

# Copy built server and static frontend assets
COPY --from=backend-builder /app/server .
COPY --from=frontend-builder /app/kifu/frontend/dist ./dist

# SQLite DB Path configuration
ENV DB_PATH=/data/kifu.db
ENV PORT=8080
EXPOSE 8080

VOLUME ["/data"]

CMD ["./server"]
